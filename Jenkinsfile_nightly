@Library('devprod-cloudbees-shared-libraries') _

pipeline {
    agent any
    triggers {
        // Nightly regression run; 'H' spreads load across the hour
        cron('H 2 * * *')
    }
    environment {
        BIN = "/go/bin"
        GO  = 'go-proxy'
        V   = '1'
    }
    stages {
        stage('Workspace Cleanup') {
            steps {
                sh '''
                    set -e
                    rm -rf proxy
                    git clean -fdx
                '''
            }
        }
        stage('Certificate Setup') {
            steps {
                sh '''
                    set -e
                    mkdir -p certs
                    cat ${DEVPROD_SSL_CERT_ARTIFACTORY_DIR}/devprod_ro.crt > certs/crt.pem
                    cat ${DEVPROD_SSL_CERT_ARTIFACTORY_DIR}/devprod_ro.key > certs/key.pem
                    cat ${DEVPROD_SSL_CERT_ARTIFACTORY_DIR}/devprod_ro.ca > certs/ca.pem
                '''
            }
        }
        stage('Tooling Source Checkout') {
            steps {
                sh 'git clone https://git.source.akamai.com/scm/devexp/proxy.git'
            }
        }
        stage('CI Image Build') {
            steps {
                sh '''
                    docker version
                    docker build -t akamaiopen-edgegrid-golang/base .
                '''
            }
        }
        stage('Code Quality Checks') {
            agent {
                docker {
                    image 'akamaiopen-edgegrid-golang/base'
                    args "-v ${env.WORKSPACE}/certs:/certs:ro"
                    reuseNode true
                }
            }
            steps {
                sh '''
                    set -e
                    make tidy-check
                    make fmt-check
                    make lint
                '''
            }
        }
        stage('Tests and Coverage') {
            agent {
                docker {
                    image 'akamaiopen-edgegrid-golang/base'
                    args "-v ${env.WORKSPACE}/certs:/certs:ro"
                    reuseNode true
                }
            }
            steps {
                sh 'make test-verbose'
                sh 'make create-coverage-files'
                recordCoverage(
                    tools: [[
                                parser : 'COBERTURA',
                                pattern: 'test/coverage/coverage.xml'
                            ]],
                    sourceDirectories: [[path: '.']],
                    failOnError: true
                )
            }
            post {
                always {
                    // Runs also when tests fail, so that the failed tests are reported
                    sh 'make create-junit-report'
                }
            }
        }
        stage('Black Duck Scan') {
            steps {
                script {
                    // PR builds: CHANGE_BRANCH; multibranch: BRANCH_NAME; plain pipeline: GIT_BRANCH (origin/...)
                    def branch = env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'unknown'
                    def allowedPrefixes = ['master', 'develop', 'feature', 'release', 'bugfix', 'hotfix']
                    def rawPrefix = branch.replaceFirst('^origin/', '').split('/')[0]
                    // Branches outside the gitflow prefixes are reported as 'feature'
                    def branchPrefix = allowedPrefixes.contains(rawPrefix) ? rawPrefix : 'feature'
                    runOsvScan(
                        projectName: 'akamaiopen-edgegrid-golang',
                        projectVersion: "akamaiopen-edgegrid-golang-${branchPrefix}",
                        tokenCredsId: 'devexp_manual_vuln_scan_token',
                        blackDuckUrl: 'https://manual.vuln.akamai.com',
                        configFilePath: '.config/blackduck/blackduck.properties'
                    )
                }
            }
        }
    }
    post {
        always {
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                junit testResults: 'test/tests.xml',
                    allowEmptyResults: false,
                    healthScaleFactor: 1.0
            }
            archiveArtifacts artifacts: 'test/**',
                allowEmptyArchive: true,
                fingerprint: true
            script {
                emailNotify()
            }
        }
        cleanup {
            deleteDir()
        }
    }
}
